# RUN: not --crash llc -mtriple=riscv32 -mattr=+y -run-pass machineverifier %s -o - 2>&1 \
# RUN:    | FileCheck %s --implicit-check-not="Bad machine code"
# RUN: not --crash llc -mtriple=riscv64 -mattr=+y -run-pass machineverifier %s -o - 2>&1 \
# RUN:    | FileCheck %s  --implicit-check-not="Bad machine code"

# CHECK:      *** Bad machine code: Invalid immediate ***
# CHECK-NEXT: - function:{{ +}}verify_all_invalid
# CHECK-NEXT: - basic block: {{%bb\.[0-9]+ .*}}
# CHECK-NEXT: - instruction: $c10 = YBNDSWI $c10, 0

---
name: verify_all_invalid
body: |
  bb.0:
    $c10 = YBNDSWI $c10, 0
...
